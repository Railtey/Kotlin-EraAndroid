@SYSTEM_TITLE
#DIM CNT
PRINTL タイトル画面
PRINTFORML 1+2={1+2}
FOR CNT, 0, 3
	PRINTFORM [{CNT}]
NEXT
PRINTL
LOCALS = %"안녕" + "世界"%
PRINTFORML %LOCALS%
CALL FIB, 10
PRINTFORML FIB(10)={RESULT}
PRINTFORML ABL名=%ABLNAME:1%
PRINTFORML 関数={MYFUNC(3, 4)}
PRINTFORML STRCOUNT={STRLENS("あいう")}
PRINTFORML SPLIT=%SPLITTEST()%
PRINTBUTTON "[0] はじめる", 0
PRINTL
PRINTBUTTON "[1] おわる", 1
PRINTL
$INPUT_LOOP
INPUT
SIF RESULT != 0 && RESULT != 1
	GOTO INPUT_LOOP
IF RESULT == 0
	PRINTL はじめました
	INPUTS
	PRINTFORML 入力=%RESULTS%
	WAIT
	PRINTL WAIT後
	TWAIT 100, 0
	PRINTL 終了
ENDIF
QUIT

@FIB, NUM
#DIM DYNAMIC NUM
#DIM DYNAMIC TMP
IF NUM < 2
	RETURN NUM
ENDIF
CALL FIB, NUM-1
TMP = RESULT
CALL FIB, NUM-2
RETURN TMP + RESULT

@MYFUNC(X1, X2)
#FUNCTION
#DIM X1
#DIM X2
RETURNF X1 * X2

@SPLITTEST
#FUNCTIONS
#DIMS ARR, 5
SPLIT "a,b,c", ",", ARR
RETURNF ARR:0 + ARR:1 + ARR:2
