@SYSTEM_TITLE
PRINTFORML A1 {GLOBALNUM} %WEEK:1%
PRINTFORML A2 {MAX(3,9,2)} {MIN(3,9,2)} {ABS(-4)} {POWER(2,10)} {SQRT(81)} {LIMIT(15,0,10)}
PRINTFORML A3 %TOSTR(255,"X")% %STRFORM("{1+1}")% {STRFIND("abcdef","cd")} %SUBSTRING("abcdef",1,3)%
PRINTFORML A4 %TOUPPER("abc")% {TOINT("123")} {ISNUMERIC("12a")} %REPLACE("aXbX","X","-")% {STRLENSU("가나")}
LOCALS:0 = あいうえお
PRINTFORML A6 %LOCALS:0% {STRLENS(LOCALS:0)} %UNICODE(0x3042)% {ENCODETOUNI("あ")}
PRINTFORML A7 {1 ? 5 # 6} {10 / 3} {10 % 3} {1 << 4} {7 & 3} {-7 / 2}
VARSET FLAG, 1
PRINTFORML A8 {FLAG:0} {FLAG:9} {SUMARRAY(FLAG,0,10)}
PRINTFORML A9 %CSVNAME(0)% {CHARANUM}
SELECTCASE 5
	CASE 1 TO 3
		PRINTL A10 NG
	CASE 4, 5
		PRINTL A10 OK
	CASEELSE
		PRINTL A10 ELSE
ENDSELECT
LOCAL = 0
WHILE LOCAL < 5
	LOCAL += 1
WEND
REPEAT 3
	LOCAL += 10
REND
DO
	LOCAL++
LOOP LOCAL < 40
PRINTFORML A11 {LOCAL} {COUNT}
TRYCCALL NOTEXIST
CATCH
	PRINTL A12 caught
ENDCATCH
CALLFORM TEST_{1+1}
PRINTFORML A13 {RESULT}
PRINTFORMC LEFT
PRINTFORMLC RIGHT
PRINTFORML A14 %GETTIMES()% 
PRINTFORML A15 {GETBIT(5,2)} {INRANGE(5,1,10)} {GROUPMATCH(3,1,2,3)} {NOSAMES(1,2,3)}
PRINTFORML A16 %DRAWLINESTR%
DRAWLINE
PRINTFORML A17 %HTML_ESCAPE("<b>")% 
HTML_PRINT "<button value='7'>[7] HTML</button>"
PRINTFORML A18 {STRCOUNT("abcabc","b")} %ESCAPE("a.b")% {FINDELEMENT(FLAG, 1)}
PRINTFORML A19
PRINTFORML A20 {STRLENS(HTML_ESCAPE("<b>"))}
PRINTL END
WAIT

@TEST_2
RETURN 42
