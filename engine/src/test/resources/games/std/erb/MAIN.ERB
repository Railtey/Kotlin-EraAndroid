@EVENTFIRST
MONEY = 500
FLAG:3 = 7
PRINTFORML キャラ数={CHARANUM} 名前=%NAME:0% 体力={MAXBASE:0:0}
SAVEDATA 0, "テストセーブ"
MONEY = 0
FLAG:3 = 0
PRINTFORML 存在={CHKDATA(0)}
LOADDATA 0

@EVENTLOAD
PRINTFORML ロード MONEY={MONEY} FLAG={FLAG:3} NAME=%NAME:0%
SETCOLOR 255, 0, 0
PRINTL 赤
RESETCOLOR
PRINTL [10] ボタン
QUIT
